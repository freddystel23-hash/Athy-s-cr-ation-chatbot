<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Athy's Studio IA - Admin Dashboard</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            background: linear-gradient(135deg, #0a0f1e 0%, #1a1f3a 100%);
            color: #ffffff;
            min-height: 100vh;
        }
        
        .admin-header {
            background: rgba(26, 31, 58, 0.9);
            backdrop-filter: blur(10px);
            padding: 20px 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .admin-header .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .admin-logo {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 1.5rem;
            font-weight: 700;
        }
        
        .admin-logo i {
            color: #d4af37;
            font-size: 2rem;
        }
        
        .admin-user {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .admin-avatar {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #d4af37, #f4d03f);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            font-weight: 700;
        }
        
        .main-content {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 20px;
        }
        
        .dashboard-header {
            margin-bottom: 40px;
        }
        
        .dashboard-title {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #d4af37, #f4d03f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .dashboard-subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            transition: all 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            border-color: #d4af37;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
        }
        
        .stat-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #d4af37, #f4d03f);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            font-size: 1.5rem;
            color: #000;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-label {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.95rem;
        }
        
        .requests-section {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 30px;
        }
        
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .section-title {
            font-size: 1.8rem;
            font-weight: 700;
        }
        
        .filter-tabs {
            display: flex;
            gap: 10px;
        }
        
        .filter-tab {
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 500;
        }
        
        .filter-tab.active,
        .filter-tab:hover {
            background: linear-gradient(135deg, #d4af37, #f4d03f);
            color: #000;
            border-color: transparent;
        }
        
        .requests-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .requests-table th {
            text-align: left;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-bottom: 2px solid #d4af37;
            font-weight: 600;
            color: #d4af37;
        }
        
        .requests-table td {
            padding: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .requests-table tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }
        
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        .status-pending {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border: 1px solid #ffc107;
        }
        
        .status-approved {
            background: rgba(0, 168, 107, 0.2);
            color: #00a86b;
            border: 1px solid #00a86b;
        }
        
        .status-rejected {
            background: rgba(220, 20, 60, 0.2);
            color: #dc143c;
            border: 1px solid #dc143c;
        }
        
        .action-btns {
            display: flex;
            gap: 10px;
        }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
        }
        
        .btn-view {
            background: rgba(0, 168, 107, 0.2);
            color: #00a86b;
            border: 1px solid #00a86b;
        }
        
        .btn-view:hover {
            background: #00a86b;
            color: #fff;
        }
        
        .btn-approve {
            background: rgba(0, 168, 107, 0.2);
            color: #00a86b;
            border: 1px solid #00a86b;
        }
        
        .btn-approve:hover {
            background: #00a86b;
            color: #fff;
        }
        
        .btn-reject {
            background: rgba(220, 20, 60, 0.2);
            color: #dc143c;
            border: 1px solid #dc143c;
        }
        
        .btn-reject:hover {
            background: #dc143c;
            color: #fff;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: #1a1f3a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            max-width: 700px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }
        
        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: none;
            color: #fff;
            font-size: 2rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .modal-close:hover {
            color: #d4af37;
            transform: rotate(90deg);
        }
        
        .modal-title {
            font-size: 2rem;
            margin-bottom: 25px;
            color: #d4af37;
        }
        
        .detail-item {
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .detail-item:last-child {
            border-bottom: none;
        }
        
        .detail-label {
            font-weight: 600;
            color: #d4af37;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }
        
        .detail-value {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            line-height: 1.6;
        }
        
        .modal-actions {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }
        
        .btn-large {
            padding: 12px 30px;
            font-size: 1rem;
            flex: 1;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.5);
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
        }
        
        .empty-state p {
            font-size: 1.1rem;
        }
        
        @media (max-width: 768px) {
            .dashboard-title {
                font-size: 2rem;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .filter-tabs {
                flex-wrap: wrap;
            }
            
            .requests-table {
                display: block;
                overflow-x: auto;
            }
            
            .modal-content {
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="admin-header">
        <div class="container">
            <div class="admin-logo">
                <i class="fas fa-shield-alt"></i>
                <span>Admin Dashboard - Athy's Studio IA</span>
            </div>
            <div class="admin-user">
                <div class="admin-avatar">A</div>
                <div>
                    <div style="font-weight: 600;">Athy's Validation</div>
                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Administrateur</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">Tableau de Bord</h1>
            <p class="dashboard-subtitle">Gestion des demandes clients traitées par Manager IA Royal</p>
        </div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <div class="stat-value" id="totalRequests">0</div>
                <div class="stat-label">Total des demandes</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-value" id="pendingRequests">0</div>
                <div class="stat-label">En attente</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-value" id="approvedRequests">0</div>
                <div class="stat-label">Approuvées</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="stat-value" id="rejectedRequests">0</div>
                <div class="stat-label">Refusées</div>
            </div>
        </div>

        <!-- Requests Section -->
        <div class="requests-section">
            <div class="section-header">
                <h2 class="section-title">Demandes Clients</h2>
                <div class="filter-tabs">
                    <button class="filter-tab active" data-filter="all">Toutes</button>
                    <button class="filter-tab" data-filter="pending">En attente</button>
                    <button class="filter-tab" data-filter="approved">Approuvées</button>
                    <button class="filter-tab" data-filter="rejected">Refusées</button>
                </div>
            </div>

            <div id="requestsTableContainer">
                <!-- Table will be populated by JavaScript -->
            </div>
        </div>
    </main>

    <!-- Modal for Request Details -->
    <div id="requestModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal()">&times;</button>
            <h2 class="modal-title">Détails de la Demande</h2>
            <div id="modalBody">
                <!-- Content will be populated by JavaScript -->
            </div>
        </div>
    </div>

    <script>
        // Sample data structure (in production, this would come from Manager IA Royal)
        let requests = [
            {
                id: 1,
                name: "Jean Dupont",
                email: "jean.dupont@example.com",
                phone: "06 12 34 56 78",
                service: "Création de Sites Internet",
                budget: "1000-2000",
                message: "Je souhaite créer un site vitrine moderne pour mon entreprise de consulting. Le site doit être responsive et optimisé SEO.",
                timestamp: "2026-02-19T10:30:00",
                status: "pending"
            },
            {
                id: 2,
                name: "Marie Martin",
                email: "marie.martin@example.com",
                phone: "07 98 76 54 32",
                service: "GPT Personnel",
                budget: "500-1000",
                message: "Besoin d'un chatbot IA pour le support client de notre boutique en ligne. Réponses automatisées 24/7.",
                timestamp: "2026-02-18T14:15:00",
                status: "approved"
            },
            {
                id: 3,
                name: "Pierre Bernard",
                email: "p.bernard@example.com",
                phone: "06 45 67 89 01",
                service: "Branding et Shooting",
                budget: "2000-5000",
                message: "Refonte complète de notre identité visuelle avec shooting photo professionnel pour notre équipe.",
                timestamp: "2026-02-17T16:45:00",
                status: "approved"
            }
        ];

        // Initialize dashboard
        function initDashboard() {
            updateStats();
            renderRequestsTable('all');
            setupFilters();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalRequests').textContent = requests.length;
            document.getElementById('pendingRequests').textContent = requests.filter(r => r.status === 'pending').length;
            document.getElementById('approvedRequests').textContent = requests.filter(r => r.status === 'approved').length;
            document.getElementById('rejectedRequests').textContent = requests.filter(r => r.status === 'rejected').length;
        }

        // Render requests table
        function renderRequestsTable(filter) {
            const container = document.getElementById('requestsTableContainer');
            let filteredRequests = requests;

            if (filter !== 'all') {
                filteredRequests = requests.filter(r => r.status === filter);
            }

            if (filteredRequests.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Aucune demande à afficher</p>
                    </div>
                `;
                return;
            }

            let html = `
                <table class="requests-table">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            filteredRequests.forEach(request => {
                const date = new Date(request.timestamp);
                const formattedDate = date.toLocaleDateString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                const statusClass = `status-${request.status}`;
                const statusText = {
                    'pending': 'En attente',
                    'approved': 'Approuvée',
                    'rejected': 'Refusée'
                };

                html += `
                    <tr>
                        <td>
                            <div style="font-weight: 600;">${request.name}</div>
                            <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">${request.email}</div>
                        </td>
                        <td>${request.service}</td>
                        <td>${formattedDate}</td>
                        <td><span class="status-badge ${statusClass}">${statusText[request.status]}</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="btn btn-view" onclick="viewRequest(${request.id})">
                                    <i class="fas fa-eye"></i> Voir
                                </button>
                                ${request.status === 'pending' ? `
                                    <button class="btn btn-approve" onclick="approveRequest(${request.id})">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn btn-reject" onclick="rejectRequest(${request.id})">
                                        <i class="fas fa-times"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            });

            html += `
                    </tbody>
                </table>
            `;

            container.innerHTML = html;
        }

        // Setup filter buttons
        function setupFilters() {
            const filterTabs = document.querySelectorAll('.filter-tab');
            filterTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    filterTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.dataset.filter;
                    renderRequestsTable(filter);
                });
            });
        }

        // View request details
        function viewRequest(id) {
            const request = requests.find(r => r.id === id);
            if (!request) return;

            const modal = document.getElementById('requestModal');
            const modalBody = document.getElementById('modalBody');

            const date = new Date(request.timestamp);
            const formattedDate = date.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: 'long',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            const statusClass = `status-${request.status}`;
            const statusText = {
                'pending': 'En attente de validation',
                'approved': 'Approuvée',
                'rejected': 'Refusée'
            };

            modalBody.innerHTML = `
                <div class="detail-item">
                    <div class="detail-label">Statut</div>
                    <div class="detail-value">
                        <span class="status-badge ${statusClass}">${statusText[request.status]}</span>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Nom du client</div>
                    <div class="detail-value">${request.name}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Email</div>
                    <div class="detail-value"><a href="mailto:${request.email}" style="color: #00a86b;">${request.email}</a></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Téléphone</div>
                    <div class="detail-value"><a href="tel:${request.phone}" style="color: #00a86b;">${request.phone}</a></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Service demandé</div>
                    <div class="detail-value">${request.service}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Budget estimé</div>
                    <div class="detail-value">${request.budget}€</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Date de la demande</div>
                    <div class="detail-value">${formattedDate}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Message</div>
                    <div class="detail-value">${request.message}</div>
                </div>
                ${request.status === 'pending' ? `
                    <div class="modal-actions">
                        <button class="btn btn-approve btn-large" onclick="approveRequest(${request.id}); closeModal();">
                            <i class="fas fa-check"></i> Approuver
                        </button>
                        <button class="btn btn-reject btn-large" onclick="rejectRequest(${request.id}); closeModal();">
                            <i class="fas fa-times"></i> Refuser
                        </button>
                    </div>
                ` : ''}
            `;

            modal.classList.add('active');
        }

        // Close modal
        function closeModal() {
            document.getElementById('requestModal').classList.remove('active');
        }

        // Approve request
        function approveRequest(id) {
            const request = requests.find(r => r.id === id);
            if (request) {
                request.status = 'approved';
                updateStats();
                const activeFilter = document.querySelector('.filter-tab.active').dataset.filter;
                renderRequestsTable(activeFilter);
                
                // In production, this would trigger Manager IA Royal to send approval email
                console.log(`Request ${id} approved by Athy's. Manager IA will notify client.`);
                alert('✅ Demande approuvée ! Le Manager IA va notifier le client.');
            }
        }

        // Reject request
        function rejectRequest(id) {
            const request = requests.find(r => r.id === id);
            if (request) {
                request.status = 'rejected';
                updateStats();
                const activeFilter = document.querySelector('.filter-tab.active').dataset.filter;
                renderRequestsTable(activeFilter);
                
                // In production, this would trigger Manager IA Royal to send rejection email
                console.log(`Request ${id} rejected by Athy's. Manager IA will notify client.`);
                alert('❌ Demande refusée. Le Manager IA va notifier le client.');
            }
        }

        // Close modal on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Initialize on load
        window.addEventListener('load', initDashboard);

        // Simulate real-time updates (in production, this would be WebSocket from Manager IA)
        setInterval(() => {
            // Check for new requests from Manager IA Royal
            console.log('Checking for new requests from Manager IA Royal...');
        }, 30000); // Check every 30 seconds
    </script>
</body>
</html>
