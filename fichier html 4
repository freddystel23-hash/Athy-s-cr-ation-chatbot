<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Athy's Studio IA</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0f1e 0%, #1a1f3a 100%);
            color: #ffffff;
            min-height: 100vh;
        }

        .admin-header {
            background: rgba(26, 31, 58, 0.95);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            border-bottom: 2px solid #d4af37;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-logo i {
            font-size: 2rem;
            color: #d4af37;
        }

        .admin-logo h1 {
            font-size: 1.8rem;
            color: #d4af37;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #000;
        }

        .container {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 40px;
        }

        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
        }

        .stat-icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .stat-card:nth-child(1) .stat-icon { color: #d4af37; }
        .stat-card:nth-child(2) .stat-icon { color: #f4d03f; }
        .stat-card:nth-child(3) .stat-icon { color: #00a86b; }
        .stat-card:nth-child(4) .stat-icon { color: #dc143c; }

        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            color: #d4af37;
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .section-header {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 2rem;
            color: #d4af37;
            margin-bottom: 10px;
        }

        .filters {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 12px 30px;
            border-radius: 25px;
            border: 2px solid #d4af37;
            background: transparent;
            color: #ffffff;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: #d4af37;
            color: #000;
        }

        .requests-table {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: rgba(212, 175, 55, 0.2);
        }

        th {
            padding: 20px;
            text-align: left;
            font-weight: 600;
            color: #d4af37;
            font-size: 1rem;
        }

        td {
            padding: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        tbody tr {
            transition: background 0.3s;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .status-badge {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .status-pending {
            background: rgba(244, 208, 63, 0.2);
            color: #f4d03f;
            border: 1px solid #f4d03f;
        }

        .status-approved {
            background: rgba(0, 168, 107, 0.2);
            color: #00a86b;
            border: 1px solid #00a86b;
        }

        .status-rejected {
            background: rgba(220, 20, 60, 0.2);
            color: #dc143c;
            border: 1px solid #dc143c;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            padding: 8px 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn-view {
            background: #1a1f3a;
            color: #d4af37;
            border: 1px solid #d4af37;
        }

        .btn-view:hover {
            background: #d4af37;
            color: #000;
        }

        .btn-approve {
            background: #00a86b;
            color: #fff;
        }

        .btn-approve:hover {
            background: #00c87a;
        }

        .btn-reject {
            background: #dc143c;
            color: #fff;
        }

        .btn-reject:hover {
            background: #ff1744;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: linear-gradient(135deg, #1a1f3a 0%, #2a3555 100%);
            border: 2px solid #d4af37;
            border-radius: 20px;
            padding: 40px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            color: #d4af37;
            cursor: pointer;
            transition: color 0.3s;
        }

        .modal-close:hover {
            color: #f4d03f;
        }

        .modal-header {
            font-size: 2rem;
            color: #d4af37;
            margin-bottom: 30px;
        }

        .detail-row {
            margin-bottom: 20px;
        }

        .detail-label {
            font-weight: 600;
            color: #d4af37;
            margin-bottom: 5px;
        }

        .detail-value {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            line-height: 1.6;
        }

        @media (max-width: 1024px) {
            .dashboard-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 20px;
            }

            .admin-header {
                padding: 15px 20px;
            }

            .dashboard-stats {
                grid-template-columns: 1fr;
            }

            .requests-table {
                overflow-x: auto;
            }

            table {
                min-width: 800px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <header class="admin-header">
        <div class="admin-logo">
            <i class="fas fa-shield-alt"></i>
            <h1>Admin Dashboard</h1>
        </div>
        <div class="admin-user">
            <span>Administrateur</span>
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
        </div>
    </header>

    <div class="container">
        <!-- Dashboard Statistics -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div class="stat-number" id="totalRequests">0</div>
                <div class="stat-label">Total Demandes</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-number" id="pendingRequests">0</div>
                <div class="stat-label">En Attente</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-number" id="approvedRequests">0</div>
                <div class="stat-label">Approuvées</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="stat-number" id="rejectedRequests">0</div>
                <div class="stat-label">Refusées</div>
            </div>
        </div>

        <!-- Requests Section -->
        <div class="section-header">
            <h2 class="section-title">Demandes Clients</h2>
        </div>

        <!-- Filters -->
        <div class="filters">
            <button class="filter-btn active" data-filter="all">Toutes</button>
            <button class="filter-btn" data-filter="pending">En Attente</button>
            <button class="filter-btn" data-filter="approved">Approuvées</button>
            <button class="filter-btn" data-filter="rejected">Refusées</button>
        </div>

        <!-- Requests Table -->
        <div class="requests-table">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Service</th>
                        <th>Budget</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="requestsTableBody">
                    <!-- Dynamic content will be inserted here -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for Request Details -->
    <div id="requestModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal()">&times;</span>
            <h2 class="modal-header">Détails de la Demande</h2>
            <div id="modalContent">
                <!-- Dynamic content will be inserted here -->
            </div>
        </div>
    </div>

    <script>
        // Sample data (replace with actual API call)
        let requests = [
            {
                id: 1,
                date: '2026-02-19',
                name: 'Jean Dupont',
                email: 'jean.dupont@example.com',
                phone: '06 12 34 56 78',
                service: 'Création de sites internet',
                budget: '800-1500€',
                message: 'Je souhaite créer un site vitrine pour mon entreprise de consulting.',
                status: 'pending'
            },
            {
                id: 2,
                date: '2026-02-18',
                name: 'Marie Martin',
                email: 'marie.martin@example.com',
                phone: '07 98 76 54 32',
                service: 'GPT personnel et avancé',
                budget: '1500-3000€',
                message: 'Besoin d\'un chatbot IA pour automatiser le support client.',
                status: 'approved'
            },
            {
                id: 3,
                date: '2026-02-17',
                name: 'Pierre Lefebvre',
                email: 'pierre.lefebvre@example.com',
                phone: '06 11 22 33 44',
                service: 'Branding et shooting visuel',
                budget: '3000€+',
                message: 'Refonte complète de l\'identité visuelle de ma marque.',
                status: 'pending'
            },
            {
                id: 4,
                date: '2026-02-16',
                name: 'Sophie Bernard',
                email: 'sophie.bernard@example.com',
                phone: '07 55 66 77 88',
                service: 'Storytelling professionnel',
                budget: '800-1500€',
                message: 'Création de contenus narratifs pour campagne marketing.',
                status: 'rejected'
            }
        ];

        // Initialize dashboard
        function initDashboard() {
            updateStats();
            renderRequests('all');
            setupFilters();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalRequests').textContent = requests.length;
            document.getElementById('pendingRequests').textContent = 
                requests.filter(r => r.status === 'pending').length;
            document.getElementById('approvedRequests').textContent = 
                requests.filter(r => r.status === 'approved').length;
            document.getElementById('rejectedRequests').textContent = 
                requests.filter(r => r.status === 'rejected').length;
        }

        // Render requests table
        function renderRequests(filter) {
            const tbody = document.getElementById('requestsTableBody');
            const filteredRequests = filter === 'all' 
                ? requests 
                : requests.filter(r => r.status === filter);

            tbody.innerHTML = filteredRequests.map(request => `
                <tr>
                    <td>${formatDate(request.date)}</td>
                    <td>${request.name}</td>
                    <td>${request.email}</td>
                    <td>${request.service}</td>
                    <td>${request.budget}</td>
                    <td>
                        <span class="status-badge status-${request.status}">
                            ${getStatusLabel(request.status)}
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="action-btn btn-view" onclick="viewRequest(${request.id})">
                                <i class="fas fa-eye"></i> Voir
                            </button>
                            ${request.status === 'pending' ? `
                                <button class="action-btn btn-approve" onclick="approveRequest(${request.id})">
                                    <i class="fas fa-check"></i> Approuver
                                </button>
                                <button class="action-btn btn-reject" onclick="rejectRequest(${request.id})">
                                    <i class="fas fa-times"></i> Refuser
                                </button>
                            ` : ''}
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Setup filters
        function setupFilters() {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    renderRequests(this.dataset.filter);
                });
            });
        }

        // View request details
        function viewRequest(id) {
            const request = requests.find(r => r.id === id);
            if (!request) return;

            const modalContent = document.getElementById('modalContent');
            modalContent.innerHTML = `
                <div class="detail-row">
                    <div class="detail-label">Date</div>
                    <div class="detail-value">${formatDate(request.date)}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Nom</div>
                    <div class="detail-value">${request.name}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Email</div>
                    <div class="detail-value">${request.email}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Téléphone</div>
                    <div class="detail-value">${request.phone}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Service</div>
                    <div class="detail-value">${request.service}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Budget</div>
                    <div class="detail-value">${request.budget}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Message</div>
                    <div class="detail-value">${request.message}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Statut</div>
                    <div class="detail-value">
                        <span class="status-badge status-${request.status}">
                            ${getStatusLabel(request.status)}
                        </span>
                    </div>
                </div>
            `;

            document.getElementById('requestModal').classList.add('active');
        }

        // Close modal
        function closeModal() {
            document.getElementById('requestModal').classList.remove('active');
        }

        // Approve request
        function approveRequest(id) {
            if (confirm('Voulez-vous vraiment approuver cette demande ?')) {
                const request = requests.find(r => r.id === id);
                if (request) {
                    request.status = 'approved';
                    updateStats();
                    renderRequests(document.querySelector('.filter-btn.active').dataset.filter);
                    alert('Demande approuvée avec succès !');
                }
            }
        }

        // Reject request
        function rejectRequest(id) {
            if (confirm('Voulez-vous vraiment refuser cette demande ?')) {
                const request = requests.find(r => r.id === id);
                if (request) {
                    request.status = 'rejected';
                    updateStats();
                    renderRequests(document.querySelector('.filter-btn.active').dataset.filter);
                    alert('Demande refusée.');
                }
            }
        }

        // Helper functions
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        }

        function getStatusLabel(status) {
            const labels = {
                pending: 'En Attente',
                approved: 'Approuvée',
                rejected: 'Refusée'
            };
            return labels[status] || status;
        }

        // Close modal on outside click
        document.getElementById('requestModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Initialize on page load
        initDashboard();
    </script>
</body>
</html>
